def testo(v) -> str:
    out: list[str] = []
    if v is None:
        return ""
    if isinstance(v, str):
        s = v.strip()
        if s[:1] in "[{" and len(s) > 2:
            try:
                return testo(json.loads(s))
            except Exception:
                pass
        out.append(v)
    elif isinstance(v, list):
        for x in v:
            out.append(testo(x))
    elif isinstance(v, dict):
        for k in ("name", "n", "entry"):
            if isinstance(v.get(k), str):
                out.append(v[k])
        for k in ("entries", "entry", "items", "rows", "d", "short"):
            if k in v:
                out.append(testo(v[k]))
    return " ".join(out)


def attiva(t: str, frasi: list[str]) -> list[str]:
    low = re.sub(r"\{@\w+([^}]*)\}", r"\1", (t or "").lower())
    low = re.sub(r"\s+", " ", low)
    return [f for f in frasi if f in low]


def assi_di(t: str, assi: dict[str, list[str]]) -> dict[str, list[str]]:
    out: dict[str, list[str]] = {}
    for k, frasi in assi.items():
        hit = attiva(t, frasi)
        if hit:
            out[k.split()[0]] = hit
    return out


def ammissibile(a: dict, regola: list[str]) -> tuple[bool, str]:
    """Applica la regola di ammissione. Ritorna (esito, motivo).

    SEMANTICA: la lista `regola` contiene ALTERNATIVE (OR), non requisiti cumulativi (AND).
    Un matcher generico messo in cima intercettava «face» prima del suo blocco specifico e
    lo faceva crollare a 1 ammissibile su 102: la regola va valutata per intero, provando
    ogni alternativa, non fermandosi alla prima che non scatta.
    """
    chiavi = set(a)
    import re as _re
    # RAMO DEDICATO «face»: due vie sociali su tre, oppure una via + lettura/economia.
    # Va valutato PRIMA delle alternative generiche: F5 da solo («at will») matcha quasi
    # tutto e porterebbe il volto all'80%, che e' il difetto opposto.
    if "*due_di_F1F2F3" in regola:
        sociali = chiavi & {"F1", "F2", "F3"}
        if len(sociali) >= 2:
            return True, "due vie sociali su tre"
        if sociali and (chiavi & {"F4", "F5"}):
            return True, "una via sociale + lettura/economia"
        return False, ("una sola via sociale senza lettura/economia: specialismo, non presenza sociale"
                       if sociali else "nessuna via sociale")
    for r in regola:
        m = _re.match(r"\*(due|tre)_di_([A-Z0-9]+)$", r)
        if not m:
            continue
        soglia = 2 if m.group(1) == "due" else 3
        gruppo = {m.group(2)[k:k + 2] for k in range(0, len(m.group(2)), 2)}
        if len(chiavi & gruppo) >= soglia:
            return True, f"almeno {m.group(1)} fra {', '.join(sorted(gruppo))}"
    # regole puntuali (non raggruppate): bastano da sole
    for r in regola:
        if not r.startswith("*") and r in chiavi:
            return True, f"copre {r}"
    # casi specifici con logica dedicata
    if "*due_di_D2D4D5" in regola:
        if chiavi & {"D3", "D6"}:
            return True, f"copre {', '.join(sorted(chiavi & {'D3', 'D6'}))}"
    return False, (f"nessuna alternativa soddisfatta fra {', '.join(regola)}: "
                   f"la meccanica piu' ovvia da sola e' la versione stretta del ruolo")


def main() -> int:
    sf = json.loads((DATA / "subclass-features.json").read_text(encoding="utf-8"))["sottoclassi"]
    D = json.loads((DATA / "character-data.json").read_text(encoding="utf-8"))
    man = D["manuali"]

    # testi dai tre contenitori
    # IL NOME VA INCLUSO: il segnale d'asse spesso sta solo li'. «Summon Aberration» ha S1
    # nel nome e non lo ripete nelle entries (che dicono «you call forth an aberrant spirit»):
    # scandendo il solo testo, l'evocatore risultava 0 ammissibili su 136.
    testi_sub = {}
    for chiave, voci in sf.items():
        nome, _, src = chiave.partition("|")
        testi_sub[(nome, src)] = nome + " " + " ".join(x.get("testo") or "" for x in voci if isinstance(x, dict))
    testi_feat = {}
    for f in D.get("feats", []):
        if isinstance(f, dict) and f.get("n"):
            testi_feat[(f["n"], f.get("s"))] = testo(f.get("n")) + " " + testo(f.get("d"))
    testi_inc = {}
    sp = DATA / "5etools" / "spells"
    for g in (sorted(sp.glob("spells-*.json")) if sp.is_dir() else []):
        try:
            d = json.loads(g.read_text(encoding="utf-8"))
        except Exception:
            continue
        for e in ((d.get("spell") if isinstance(d, dict) else d) or []):
            if isinstance(e, dict) and e.get("name"):
                testi_inc[(e["name"], e.get("source"))] = str(e["name"]) + " " + testo(e.get("entries"))

    out: dict[str, dict] = {}
    for rk, r in RUOLI.items():
        per_sub, per_feat, per_inc = [], [], []
        for (nome, src), txt in testi_sub.items():
            a = assi_di(txt, r["assi"])
            if a:
                ok, perche = ammissibile(a, r["ammissione"])
                per_sub.append({"nome": nome, "s": src, "manuale": man.get(src, {}).get("libro", src),
                                "assi": sorted(a), "ammissibile": ok, "perche": perche})
        for (nome, src), txt in testi_feat.items():
            a = assi_di(txt, r["assi"])
            if a:
                ok, perche = ammissibile(a, r["ammissione"])
                per_feat.append({"nome": nome, "s": src, "assi": sorted(a), "ammissibile": ok, "perche": perche})
        for (nome, src), txt in testi_inc.items():
            a = assi_di(txt, r["assi"])
            if a:
                ok, perche = ammissibile(a, r["ammissione"])
                per_inc.append({"nome": nome, "s": src, "assi": sorted(a), "ammissibile": ok, "perche": perche})
        for lst in (per_sub, per_feat, per_inc):
            lst.sort(key=lambda x: (-len(x["assi"]), x["nome"]))
        out[rk] = {"nome": r["nome"], "assi": {k: k for k in r["assi"]}, "regola": r["regola"],
                   "sottoclassi": {"con_assi": len(per_sub),
                                   "ammissibili": sum(1 for x in per_sub if x["ammissibile"]),
                                   "migliori": [x for x in per_sub if x["ammissibile"]][:20]},
                   "talenti": {"con_assi": len(per_feat),
                               "ammissibili": sum(1 for x in per_feat if x["ammissibile"]),
                               "migliori": [x for x in per_feat if x["ammissibile"]][:15]},
                   "incantesimi": {"con_assi": len(per_inc),
                                   "ammissibili": sum(1 for x in per_inc if x["ammissibile"]),
                                   "migliori": [x for x in per_inc if x["ammissibile"]][:15]}}

    OUT.write_text(json.dumps({"nota": ("Assi di ruolo misurati sul testo reale da TRE contenitori "
                                        "(sottoclassi, talenti, incantesimi). Ogni ruolo ha una regola di "
                                        "ammissione: contiene chi copre il ruolo, non chi lo sfiora."),
                               "ruoli": out}, ensure_ascii=False, indent=1), encoding="utf-8")
    for rk, v in out.items():
        s, f, i = v["sottoclassi"], v["talenti"], v["incantesimi"]
        print(f"\n=== {v['nome'].upper()} ===")
        print(f"  regola: {v['regola']}")
        print(f"  sottoclassi: {s['con_assi']} con assi -> {s['ammissibili']} AMMISSIBILI")
        print(f"  talenti:     {f['con_assi']} con assi -> {f['ammissibili']} ammissibili")
        print(f"  incantesimi: {i['con_assi']} con assi -> {i['ammissibili']} ammissibili")
        for x in s["migliori"][:5]:
            print(f"     {x['nome'][:28]:28s} [{x['s']:6s}] {','.join(x['assi'])}  ({x['perche'][:44]})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
